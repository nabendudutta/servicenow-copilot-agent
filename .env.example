# ============================================================
#  ServiceNow Copilot Agent — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git — it is in .gitignore.
# ============================================================

# ── ServiceNow Instance ──────────────────────────────────────
# Full URL of your ServiceNow instance (no trailing slash)
SERVICENOW_INSTANCE=https://YOUR_INSTANCE.service-now.com

# ── Authentication ───────────────────────────────────────────
# Basic Auth (always required as fallback)
SERVICENOW_USERNAME=your_api_user
SERVICENOW_PASSWORD=your_api_password

# OAuth2 (optional — recommended for production)
# Leave blank to use Basic Auth only.
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# ── Sync Configuration ───────────────────────────────────────
# Which tables to sync: full | incidents | changes | problems | knowledge
SYNC_TYPE=full

# How far back to look for updated records (hours)
SYNC_LOOKBACK_HOURS=8

# Maximum records to fetch per table per sync run
MAX_RECORDS_PER_TABLE=500
